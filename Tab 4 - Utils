particles={}

function sgn(v)
 if v < 0 then return -1 end
 return 1
end

function init_particles()
 particles={}
end

function clear_particles()
 particles={}
end

function add_particle(x,y,dx,dy,life,col,grav_amt)
 add(particles,{
  x=x,
  y=y,
  dx=dx,
  dy=dy,
  life=life,
  col=col,
  grav=grav_amt
 })
end

function spawn_blood_particles(x,y,n)
 for i=1,n do
  local ang=rnd(1)
  local dx=(rnd(2)-1)*1.4
  local dy=-(rnd(1.5))+0.2

  local col=8
  if rnd(1)<0.35 then col=2 end

  add_particle(
   x+rnd(6)-3,
   y+rnd(6)-3,
   dx,
   dy,
   8+flr(rnd(6)),
   col,
   0.12
  )
 end
end

function spawn_crate_particles(x,y,dir,n)
 for i=1,n do
  local dx=dir*(1+rnd(1.8)) + (rnd(0.4)-0.2)
  local dy=-(0.4+rnd(1.2))

  local col=4
  if rnd(1)<0.35 then col=9 end
  if rnd(1)<0.15 then col=15 end

  add_particle(
   x+rnd(6)-3,
   y+rnd(6)-3,
   dx,
   dy,
   10+flr(rnd(6)),
   col,
   0.14
  )
 end
end

function spawn_kick_fx()
 local dir=p.face
 local ox=(dir==1) and p.w-1 or 0
 local x=p.x+ox
 local y=p.y+9

 for i=-3,3 do
  local col=12
  if rnd(1)<0.45 then col=1 end

  add_particle(
   x,
   y,
   dir*(0.7+rnd(0.5)),
   i*0.18,
   6+flr(rnd(3)),
   col,
   0
  )
 end
end

function update_particles()
 for pfx in all(particles) do
  pfx.x += pfx.dx
  pfx.y += pfx.dy
  pfx.dy += pfx.grav
  pfx.dx *= 0.95
  pfx.life -= 1

  if pfx.life <= 0 then
   del(particles,pfx)
  end
 end
end

function draw_particles()
 for pfx in all(particles) do
  pset(pfx.x,pfx.y,pfx.col)
 end
end
