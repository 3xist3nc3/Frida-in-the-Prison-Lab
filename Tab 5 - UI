 local x=13
 local y=31
 local w=102
 local h=66

 rectfill(x,y,x+w,y+h,1)
 rect(x,y,x+w,y+h,11)

 for i=1,#msg_lines do
  local txt=msg_lines[i]
  local tx=64-#txt*2
  print(txt,tx,y+3+i*7,9)
 end

